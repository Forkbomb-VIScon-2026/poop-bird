# Static file server for the built game. Camera access needs a secure context,
# so put this behind HTTPS (a reverse proxy, or change the site address to a
# domain and let Caddy get a certificate).
:8080 {
	# The bird's voice: lines in the player's voice (voice/server.py, the "voice"
	# container). They stream back one by one, so don't buffer the response.
	handle /api/voice/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy voice:8790 {
			flush_interval -1
		}
	}

	# Face dataset uploads and downloads go to the collector container
	# (collector/server.ts, reachable as "collector" on the shared network).
	handle /api/* {
		request_body {
			max_size 40MB
		}
		reverse_proxy collector:8787
	}

	handle {
		root * /srv
		encode zstd gzip
		file_server

		@wasm path *.wasm
		header @wasm Content-Type application/wasm

		@static path /assets/* /mediapipe/*
		header @static Cache-Control "public, max-age=604800"
	}
}
