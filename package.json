{
  "name": "poopy-bird",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --mode debug",
    "build": "npm run typecheck && vite build",
    "build:debug": "npm run typecheck && vite build --mode debug",
    "preview": "vite preview",
    "app:run": "npm run build && cap run android",
    "app:dev": "node scripts/app-dev.mjs",
    "app:open": "cap open android",
    "app:release": "npm run build && cap sync android && cd android && ./gradlew assembleRelease bundleRelease",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "collector": "node collector/server.ts",
    "tunnel": "ssh -N -o ExitOnForwardFailure=yes -L 8788:localhost:8080 viscon@24-direct.viscon-hackathon.ch",
    "data:pull": "node scripts/data.ts pull",
    "data:purge": "node scripts/data.ts purge",
    "leaderboard": "node scripts/leaderboard.ts",
    "eval": "node scripts/run-ts.mjs scripts/eval/main.ts",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "predev:debug": "node scripts/copy-wasm.mjs",
    "prebuild:debug": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@vladmandic/face-api": "^1.7.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
