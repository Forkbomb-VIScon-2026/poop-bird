{
  "name": "poop-bird",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --mode debug",
    "build": "npm run typecheck && vite build",
    "build:debug": "npm run typecheck && vite build --mode debug",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "collector": "node collector/server.ts",
    "data:pull": "node scripts/data.ts pull",
    "data:purge": "node scripts/data.ts purge",
    "eval": "node scripts/run-ts.mjs scripts/eval/main.ts",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "predev:debug": "node scripts/copy-wasm.mjs",
    "prebuild:debug": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
